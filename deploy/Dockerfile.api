# Muisti API: FastAPI + bge-m3 on CPU (no GPU on the demo server).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models
WORKDIR /app
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install "fastapi>=0.115" "uvicorn[standard]>=0.32" "pymysql>=1.1" "numpy>=2.0" "sentence-transformers>=3.3" \
      "mwparserfromhell>=0.6" "pydantic>=2.9" "snowballstemmer>=3.1.1" "pystemmer>=3.1.0" "anthropic>=2.8.0" "pyarrow>=18"
# the embedding model is baked into the image (~2.3 GB): no download when the container starts
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-m3')"
COPY backend ./backend
COPY pipeline ./pipeline
ENV HF_HUB_OFFLINE=1
EXPOSE 8000
CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
